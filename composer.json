{
    "name": "rastro/inventario",
    "description": "Rastro del Istmo - Sistema de Inventario",
    "require": {
        "phpoffice/phpspreadsheet": "^3.0",
        "tecnickcom/tcpdf": "^6.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "classmap": [
            "app/Config/Database.php",
            "app/Interfaces",
            "app/Utils",
            "app/Models",
            "app/Controllers"
        ]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "test": [
            "@putenv XDEBUG_MODE=off",
            "@putenv RASTRO_DB_NAME=rastroinventario_test",
            "phpunit"
        ],
        "test:unit": [
            "@putenv XDEBUG_MODE=off",
            "@putenv RASTRO_DB_NAME=rastroinventario_test",
            "phpunit --testsuite Unit"
        ],
        "test:integration": [
            "@putenv XDEBUG_MODE=off",
            "@putenv RASTRO_DB_NAME=rastroinventario_test",
            "phpunit --testsuite Integration"
        ],
        "test:volumen": [
            "@putenv XDEBUG_MODE=off",
            "@putenv RASTRO_DB_NAME=rastroinventario_test",
            "php tests/Support/cargar_volumen.php"
        ],
        "test:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File database/instalar.ps1 -Base rastroinventario_test -Recrear"
    }
}
